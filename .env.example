# Cloudflare deployment only. Local development does not require credentials.
CLOUDFLARE_API_TOKEN=
# R2 state authentication derives from CLOUDFLARE_API_TOKEN automatically.
# Optional override: R2 Object Read & Write credentials scoped to the
# warframe-toolkit-terraform bucket. Leave both unset to use the API token.
# These are R2 credentials; no Amazon AWS account is involved.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
